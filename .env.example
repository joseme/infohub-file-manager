# Optional overrides — any variable set here takes priority over the
# matching config.json value. Leave unset to configure everything from the
# app's own ⚙️ Configuración panel instead. Copy to .env to use this file:
#   cp .env.example .env

# AnythingLLM API Configuration
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_BASE_URL=http://localhost:3001

# Ollama Configuration (para descripciones de imagenes)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava:latest

# Image Description Settings
IMAGE_DESCRIPTION_ACTIVATE=true

# Application Settings
APP_PORT=8500
APP_TITLE=InfoHub File Manager

# Watched Folders Configuration
WATCHED_FOLDERS_ROOT=

# Workspaces que el file manager no sincroniza ni limpia (se cargan aparte).
# Separados por coma. Por defecto: tributacion, odoo17
PROTECTED_WORKSPACES=

# Logging
LOG_LEVEL=INFO
LOG_FILE=infohub.log

# InfoHub ecosystem portal (public URL, e.g. https://infohub.example.com/portal).
# Shows the "Inicio" button. SSO tickets are redeemed against ANYTHINGLLM_BASE_URL.
PORTAL_URL=
